{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(?!docs(?:/|$)|stats(?:/|$)).*$",
      "headers": {
        "Access-Control-Allow-Origin": "https://bitsocial.net",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; connect-src 'self' https://newsletter.bitsocial.net; font-src 'self' https://fonts.gstatic.com; form-action 'self' https://newsletter.bitsocial.net; frame-ancestors 'none'; img-src 'self' data: https:; object-src 'none'; script-src 'self' 'sha256-cd+HpnSsLaEz1lKWBNn+k+xOe1m2p5ZgfjoyNvHy9eU='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "^/apps/?$",
      "status": 308,
      "headers": {
        "Location": "/projects?category=apps"
      }
    },
    {
      "src": "^/apps/([^/]+)/?$",
      "status": 308,
      "headers": {
        "Location": "/projects/$1"
      }
    },
    {
      "src": "^/docs/?$",
      "status": 308,
      "headers": {
        "Location": "https://docs.bitsocial.net/"
      }
    },
    {
      "src": "^/docs/(.*)$",
      "status": 308,
      "headers": {
        "Location": "https://docs.bitsocial.net/$1"
      }
    },
    {
      "src": "^/stats/?$",
      "status": 308,
      "headers": {
        "Location": "https://stats.bitsocial.net/"
      }
    },
    {
      "src": "^/stats/(.*)$",
      "status": 308,
      "headers": {
        "Location": "https://stats.bitsocial.net/$1"
      }
    },
    {
      "src": "^/$",
      "dest": "/api/ssr"
    },
    {
      "src": "^/(about|privacy)/?$",
      "dest": "/api/ssr"
    },
    {
      "src": "^/projects/?$",
      "dest": "/api/ssr"
    },
    {
      "src": "^/projects/spam-blocker/?$",
      "status": 308,
      "headers": {
        "Location": "/projects/spamblocker"
      }
    },
    {
      "src": "^/projects/[^/]+/?$",
      "dest": "/api/ssr"
    },
    {
      "handle": "hit"
    },
    {
      "src": "^/assets/[^/]+-[A-Za-z0-9_-]{8}\\d*\\.(?:js|css)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/ssr"
    }
  ]
}
