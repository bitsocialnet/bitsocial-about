{
  "plugins": ["react"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "node_modules/**",
    "build/**",
    "dist/**",
    "dist-server/**",
    ".vite/**",
    "public/**",
    ".agents/skills/**",
    ".claude/skills/**"
  ]
}
